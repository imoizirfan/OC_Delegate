#!/usr/bin/env bash
set -euo pipefail

# install.sh symlinks this file onto PATH, so BASH_SOURCE must be resolved
# through the symlink to find src/cli.ts — macOS's readlink has no -f
# (that's GNU-only), so this walks symlinks by hand instead of depending on
# a coreutils flag that may not exist on this machine.
resolve_path() {
  local target="$1"
  while [ -L "$target" ]; do
    local link
    link="$(readlink "$target")"
    if [[ "$link" == /* ]]; then
      target="$link"
    else
      target="$(dirname "$target")/$link"
    fi
  done
  echo "$target"
}

SELF="$(resolve_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
exec bun "$SCRIPT_DIR/../src/cli.ts" "$@"
